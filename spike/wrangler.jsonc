{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rejgau-spike",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "SESSION", "class_name": "GatewaySession" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GatewaySession"] }],
  "observability": { "enabled": true }
  // Secrets (wrangler secret put): SPIKE_KEY (required), DISCORD_TOKEN (for /gateway/start)
}
